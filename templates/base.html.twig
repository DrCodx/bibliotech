<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>{% block title %}BiblioTech{% endblock %}</title>

        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}
    </head>

    <body>
        <header class="entete">
            <div class="conteneur entete-contenu">
                <a href="{{ path('app_catalogue') }}" class="logo">
                    Biblio<span>Tech</span>
                </a>

                <nav class="menu" aria-label="Navigation principale">
                    <a
                        href="{{ path('app_catalogue') }}"
                        class="{{ app.current_route in ['app_catalogue', 'app_livre'] ? 'actif' : '' }}"
                    >
                        Catalogue
                    </a>

                    <a
                        href="{{ path('app_populaires') }}"
                        class="{{ app.current_route == 'app_populaires' ? 'actif' : '' }}"
                    >
                        Les plus empruntés
                    </a>
                </nav>
            </div>
        </header>

        {% block body %}{% endblock %}

        <footer class="pied">
            <div class="conteneur pied-contenu">
                <span>BiblioTech — médiathèque de quartier</span>
                <span>Prêt de 3 semaines, renouvelable une fois</span>
            </div>
        </footer>
    </body>
</html>