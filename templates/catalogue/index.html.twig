{% extends 'base.html.twig' %}

{% block title %}Catalogue — BiblioTech{% endblock %}

{% block body %}
    <main class="conteneur">
        <section class="catalogue-entete">
            <div>
                <h1 class="page-titre">Le catalogue</h1>

                <p class="page-sous-titre">
                    {{ livres|length }} livre{{ livres|length > 1 ? 's' : '' }}
                </p>
            </div>

            <form
                method="get"
                action="{{ path('app_catalogue') }}"
                class="filtres"
            >
                <select name="genre" aria-label="Genre">
                    <option
                        value=""
                        {{ filtres.genre == '' ? 'selected' : '' }}
                    >
                        Tous les genres
                    </option>

                    {% for genre in genres %}
                        <option
                            value="{{ genre }}"
                            {{ genre == filtres.genre ? 'selected' : '' }}
                        >
                            {{ genre }}
                        </option>
                    {% endfor %}
                </select>

                <select name="auteur" aria-label="Auteur">
                    <option
                        value=""
                        {{ filtres.auteur == '' ? 'selected' : '' }}
                    >
                        Tous les auteurs
                    </option>

                    {% for auteur in auteurs %}
                        <option
                            value="{{ auteur }}"
                            {{ auteur == filtres.auteur ? 'selected' : '' }}
                        >
                            {{ auteur }}
                        </option>
                    {% endfor %}
                </select>

                <select name="tri" aria-label="Ordre de tri">
                    <option
                        value=""
                        {{ filtres.tri == '' ? 'selected' : '' }}
                    >
                        Trier par titre
                    </option>

                    <option
                        value="annee_desc"
                        {{ filtres.tri == 'annee_desc' ? 'selected' : '' }}
                    >
                        Plus récents d'abord
                    </option>

                    <option
                        value="annee_asc"
                        {{ filtres.tri == 'annee_asc' ? 'selected' : '' }}
                    >
                        Plus anciens d'abord
                    </option>
                </select>

                <button type="submit" class="bouton">Filtrer</button>

                <a
                    href="{{ path('app_catalogue') }}"
                    class="lien-reset"
                >
                    Réinitialiser
                </a>
            </form>
        </section>

        <section class="grille" aria-label="Livres du catalogue">
            {% for livre in livres %}
                {% include 'catalogue/_carte.html.twig' with {
                    livre: livre
                } only %}
            {% else %}
                <p>Aucun livre ne correspond à ces filtres.</p>
            {% endfor %}
        </section>
    </main>
{% endblock %}